# Copia este archivo a ".env" y ajusta los valores antes de desplegar.
# Todas las variables se leen en un solo lugar: core/config.py.
# Sin .env (desarrollo local, tests, CI) se usan valores por defecto seguros
# solo para desarrollo: claves aleatorias por proceso y SQLite local.

# Entorno: development | production (en production se ocultan /docs y /redoc)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Seguridad
SECRET_KEY=cambia-esta-clave-en-produccion
ADMIN_CODE=codigo-secreto-para-admins
ALGORITHM=HS256
TOKEN_EXPIRE_DAYS=7

# Base de datos (SQLAlchemy). Sin definir: SQLite en backend/veterinary.db.
# Ejemplo PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/cityvet
DATABASE_URL=

# CORS — orígenes permitidos separados por coma.
# Sin definir, se permite cualquier origen (solo válido para desarrollo).
CORS_ORIGINS=http://localhost:4201,https://tu-dominio.com

# Notificaciones push (Web Push / VAPID) — ver infrastructure/push/web_push.py.
# Sin definir, el backend genera un par NUEVO en cada arranque: las
# suscripciones de los navegadores dejan de recibir avisos tras cada
# reinicio (también con uvicorn --reload). Genera un par estable con:
#   python scripts/generate_vapid_keys.py
# y pega aquí las dos líneas que imprime.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PEM=
VAPID_CLAIMS_EMAIL=mailto:contacto@cityvet.pe
