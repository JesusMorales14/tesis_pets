/* ═══════════════════════════════════════════════════════════════════════
   ACCIONES (Botones admin) - Dentro de payment-modal-info, centrados abajo
   ═══════════════════════════════════════════════════════════════════════ */

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 20px 24px 24px;
  margin-top: auto; /* Se empuja al final del flex container */
  width: 100%;
  border-top: 1px solid var(--app-border);
  background: var(--app-surface);

  @media (max-width: 767px) {
    /* Móvil: botones apilados, centrados */
    align-items: center;
    border-radius: 0 0 24px 24px;

    ion-button {
      width: 100%;
      max-width: 320px;
    }
  }

  @media (min-width: 480px) and (max-width: 767px) {
    /* Tablet: botones lado a lado, centrados */
    flex-direction: row;
    justify-content: center;
    gap: 12px;

    ion-button {
      width: auto;
      min-width: 160px;
    }
  }

  @media (min-width: 768px) {
    /* Desktop: botones lado a lado, centrados en la columna derecha */
    flex-direction: row;
    justify-content: center;
    gap: 12px;
    padding: 20px 32px 28px;
    border-radius: 0 0 24px 0;

    ion-button {
      width: auto;
      min-width: 180px;
    }
  }

  ion-button {
    --border-radius: 14px;
    height: 48px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    text-transform: none;
    letter-spacing: 0.01em;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.08);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgb(0 0 0 / 0.12);
    }

    &:active {
      transform: translateY(0) scale(0.98);
    }

    &.button-outline {
      --border-width: 2px;
      background: transparent;

      &:hover {
        --background: var(--app-border);
      }
    }

    ion-icon {
      font-size: 20px;
      margin-top: 0;
    }

    .button-inner {
      display: flex;
      align-items: center;
      gap: 8px;
    }
  }
}